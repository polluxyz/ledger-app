{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 150000,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-status.mjs\""
          }
        ]
      }
    ]
  }
}
