{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Lock the emit root to src so any stray file pulled into the build
    // (e.g. prisma.config.ts at the package root) fails loudly with TS6059
    // instead of silently shifting the dist/ layout.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
