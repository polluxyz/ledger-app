generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LedgerRole {
  OWNER
  EDITOR
  VIEWER
}

/// 帳本是給自己記的，還是要與別人共用。建立後不可變更。
enum LedgerKind {
  PERSONAL
  SHARED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER // 帳戶之間的資金移動：不計入收入也不計入支出
  // 借還帳（3b）：資金方向固定，不計入收入也不計入支出。只能從債務端點產生。
  LEND // 借出：錢從帳戶出去
  BORROW // 借入：錢進到帳戶
  COLLECT // 收回：債權人收到還款，錢進到帳戶
  REPAY // 償還：債務人還錢，錢從帳戶出去
}

model User {
  id           String   @id @default(uuid())
  /// 只存小寫。DTO 層會先轉小寫，資料庫另有 CHECK 約束 `User_email_lowercase`
  /// 兜底（見 migration `20260923120000_lowercase_user_email`；Prisma schema 表達不了 CHECK）。
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  LedgerMember[]
  transactions Transaction[]  @relation("TransactionCreator")
  accounts     Account[]

  // 好友系統（3a）。Friendship 一對只存一筆，所以一個人可能出現在 low 或 high 任一側。
  friendshipsAsLow       Friendship[]       @relation("FriendshipLow")
  friendshipsAsHigh      Friendship[]       @relation("FriendshipHigh")
  friendRequestsSent     FriendRequest[]    @relation("FriendRequestSent")
  friendRequestsReceived FriendRequest[]    @relation("FriendRequestReceived")
  friendInviteLinks      FriendInviteLink[] @relation("FriendInviteLinkCreated")
  friendInviteLinksUsed  FriendInviteLink[] @relation("FriendInviteLinkUsed")

  // 借還帳（3b）。債務屬於使用者，不屬於帳本（spec 決策 17）。
  counterparties Counterparty[]

  // 往來帳連動（3b-2）。CounterpartyLink 一對只存一筆，排序規則同 Friendship。
  counterpartyLinksAsLow  CounterpartyLink[] @relation("CounterpartyLinkLow")
  counterpartyLinksAsHigh CounterpartyLink[] @relation("CounterpartyLinkHigh")
  debtProposalsSent       DebtProposal[]     @relation("DebtProposalFrom")
  debtProposalsReceived   DebtProposal[]     @relation("DebtProposalTo")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// 一對好友只存一筆。為了讓 (A, B) 與 (B, A) 不會各存一次，一律把 id 較小者放
/// userLowId、較大者放 userHighId。存兩筆的話，只要有一條路徑漏寫一筆，關係就只剩單邊。
///
/// 資料庫另有 CHECK 約束 `Friendship_ordered`（userLowId < userHighId），擋住忘了排序
/// 或兩個 id 相同的寫入。Prisma schema 表達不了 CHECK，只存在於 migration。
model Friendship {
  userLowId  String
  userHighId String
  createdAt  DateTime @default(now())

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@id([userLowId, userHighId])
  @@index([userHighId])
}

/// 以 email 送出的好友邀請。狀態機見 spec §3.1：只有 PENDING 能轉換。
///
/// 同一對發起者與收件者最多一筆 PENDING——由部分唯一索引
/// `FriendRequest_one_pending_per_pair` 保證（Prisma 不支援部分索引，只存在於 migration）。
model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  /// 接受、拒絕或取消的時間。
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  /// 連動邀請（3b-2 決策 56）：發起者這邊要接上的對象。null＝一般好友邀請。
  /// Cascade：對象被刪，邀請跟著消失（還沒連動的對象可以刪）。
  counterpartyId String?

  requester    User          @relation("FriendRequestSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient    User          @relation("FriendRequestReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([requesterId, status])
}

/// 好友邀請連結。10 分鐘過期、只能用一次；同一人產生新連結時，舊的未使用連結失效。
/// 狀態不另存欄位，由 usedAt / revokedAt / expiresAt 推得（spec §3.2）。
model FriendInviteLink {
  id        String    @id @default(uuid())
  inviterId String
  /// token 的 SHA-256（hex）。原文只在產生當下回給產生者一次，資料庫外洩時有效連結不會跟著外洩。
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  /// 同一人產生新連結時，舊的未使用連結在此標記失效。
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// 連動邀請連結（3b-2 決策 56）：產生者這邊要接上的對象。null＝一般好友連結。
  counterpartyId String?

  inviter      User          @relation("FriendInviteLinkCreated", fields: [inviterId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  // SetNull：使用者被刪掉，不該連帶刪掉別人產生過的連結紀錄。
  usedBy       User?         @relation("FriendInviteLinkUsed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([inviterId])
}

/// 錢實際放在哪裡（現金、某家銀行、某張信用卡）。
/// 帳戶屬於「使用者」而非帳本：同一張信用卡若綁帳本，在多本帳本要各建一次、
/// 餘額各算各的，必定是錯的。因此帳戶跨帳本共用。
model Account {
  id             String   @id @default(uuid())
  userId         String
  name           String
  /// 開始使用本系統時該帳戶已有的金額；可為負（例如信用卡既有欠款）
  initialBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Cascade: 使用者被刪除時，其帳戶一併移除。
  // 對 Transaction 則採預設的 Restrict——仍被引用的帳戶不可刪（app 層先擋並回 409，
  // DB 為最後一道防線）。
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionToAccount")

  @@unique([userId, name]) // 同一使用者下名稱唯一
}

model Ledger {
  id            String     @id @default(uuid())
  name          String
  currency      String     @default("TWD") // ISO 4217，階段一僅開放 TWD
  /// 私人帳本不得加入成員；共享帳本即使只剩一位成員，仍然是共享帳本。
  /// 建立後不可變更——轉換會讓「這本帳本誰看得到」在事後改變，而使用者未必察覺。
  /// 也因為共享帳本可能只有一位成員，這件事無法從成員數推導，必須是一個真正的欄位。
  kind          LedgerKind @default(PERSONAL)
  /// 此帳本的交易是否計入我的帳戶餘額。建立後不可變更（事後改會讓餘額突然跳動）。
  /// false 用於臨時性、「錢不是我的」的帳本，例如出遊分帳、社團公款。
  tracksBalance Boolean    @default(true)
  /// 封存時間；封存後轉為唯讀，且預設不列於帳本清單。
  /// 用封存取代刪除，是因為別人刪掉共享帳本會讓你的餘額被回溯性改變。
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  members      LedgerMember[]
  categories   Category[]
  transactions Transaction[]
}

model LedgerMember {
  ledgerId  String
  userId    String
  role      LedgerRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ledgerId, userId])
}

model Category {
  id        String          @id @default(uuid())
  ledgerId  String
  name      String
  type      TransactionType
  /// 顯示順序。預設分類依 `DEFAULT_CATEGORIES` 的定義順序填 0..n，讓「餐飲」
  /// 這類常用分類排在前面。
  ///
  /// 為什麼不能靠 `createdAt`：預設分類是 `createMany` 一次寫入的，12 筆的時間戳
  /// 完全相同，排序因此沒有確定結果——同一組分類在不同帳本會排成不同順序。
  /// 既有資料拿到預設值 0，它們之間改由次要排序鍵 `name` 決定。
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  ledger       Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([ledgerId, type, name])
}

model Transaction {
  id          String          @id @default(uuid())
  ledgerId    String
  /// 可空：TRANSFER 沒有分類。EXPENSE / INCOME 則由 service 強制必填。
  categoryId  String?
  /// 錢從哪個帳戶出去（INCOME 則是進到哪個帳戶）。
  /// 連動帳本必填、非連動帳本必為 null——條件必填由 service 把關。
  accountId   String?
  /// 僅 TRANSFER 使用：轉入的帳戶。
  toAccountId String?
  creatorId   String
  type        TransactionType
  amount      Int // 最小貨幣單位的整數，> 0；TWD 即為「元」
  date        DateTime // 消費日期（含時間，查詢以日期區間篩選）
  note        String?
  deletedAt   DateTime? // 軟刪除標記
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Cascade：刪除帳本會一併刪掉它的交易。
  // Category / Account 明確指定 Restrict——**選填關聯的 Prisma 預設是 SetNull**，
  // 那會讓「刪掉仍被引用的分類／帳戶」悄悄把交易的欄位清成 null，而不是報錯。
  // app 層本來就會先擋下並回 409，這裡的 Restrict 是最後一道防線。
  ledger    Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account   Account?  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  creator   User      @relation("TransactionCreator", fields: [creatorId], references: [id])

  // 借還帳（3b）：這筆交易若是某筆債務的本金或還款，由債務那一側持有外鍵（spec §4.4）。
  debtEntry DebtEntry?

  @@index([ledgerId, date])
  @@index([ledgerId, categoryId])
  @@index([accountId])
  @@index([toAccountId])
}

/// 往來紀錄的種類（spec 3b §3.2）。前 5 種由使用者記；SETTLEMENT、FORGIVE 是系統算出的調整紀錄。
enum DebtEntryKind {
  LEND // 借出：對方多欠我（delta > 0），帳戶 −
  BORROW // 借入：我多欠對方（delta < 0），帳戶 +
  COLLECT // 對方還我（delta < 0），帳戶 +
  REPAY // 我還對方（delta > 0），帳戶 −
  PAID_FOR_ME // 對方幫我付我那份（delta < 0），產生一筆不經過帳戶的支出
  SETTLEMENT // 以此結清的差額，讓往來餘額歸零；不產生交易
  FORGIVE // 免除對方欠我的剩餘金額（delta < 0）；不產生交易
  FORGIVEN // 被對方免除（3b-2）：接受對方的免除時寫入，讓我欠的歸零（delta > 0）；不產生交易
}

/// 記帳者的一個往來對象，只存名字（spec 3b 決策 33）。一個對象一本往來帳。
///
/// 資料庫另有 CHECK 約束 `Counterparty_name_trimmed`（名字已去掉前後空白、1～100 字）。
model Counterparty {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries DebtEntry[]

  // 連動（3b-2）：一個對象最多出現在一筆 CounterpartyLink 的其中一側。
  linkAsLow         CounterpartyLink?  @relation("CounterpartyLinkLowCounterparty")
  linkAsHigh        CounterpartyLink?  @relation("CounterpartyLinkHighCounterparty")
  friendRequests    FriendRequest[]
  friendInviteLinks FriendInviteLink[]

  @@unique([ownerId, name])
}

/// 一筆往來紀錄。往來餘額 = Σ 未刪除紀錄的 delta，**不存欄位**（spec 3b 決策 34）。
///
/// 資料庫另有兩條 CHECK 約束，只存在於 migration：
/// - `DebtEntry_delta_sign`：delta ≠ 0，且正負號與 kind 相符。
/// - `DebtEntry_transaction_by_kind`：調整紀錄沒有交易；PAID_FOR_ME 一定有交易。
model DebtEntry {
  id             String        @id @default(uuid())
  counterpartyId String
  kind           DebtEntryKind
  /// 對往來餘額的影響，有正負號。正數＝這筆讓對方多欠我。最小貨幣單位。
  delta          Int
  date           DateTime
  note           String?
  /// 產生的交易。調整紀錄與「不記入帳本」為 null。
  transactionId  String?       @unique
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  // Restrict：仍被往來紀錄引用的交易不可被真刪。帳本真刪會 cascade 刪交易，所以帳本那一側
  // 另外先擋（LEDGER_HAS_DEBT_TRANSACTIONS，spec 決策 21），這裡是最後防線。
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  /// 對方那邊配對的紀錄（3b-2）。雙向各存一次，在同一個資料庫交易裡寫入與清空。
  /// SetNull：對方刪帳號時他的紀錄跟著刪，我的紀錄自動變回未配對。
  pairedEntryId String?    @unique
  pairedEntry   DebtEntry? @relation("DebtEntryPair", fields: [pairedEntryId], references: [id], onDelete: SetNull)
  pairedBy      DebtEntry? @relation("DebtEntryPair")

  proposalsAsSource DebtProposal[] @relation("DebtProposalSource")
  proposalsAsTarget DebtProposal[] @relation("DebtProposalTarget")

  @@index([counterpartyId, deletedAt])
}

enum DebtProposalType {
  CREATE // 連動後新增一筆
  AMEND // 改了已配對紀錄的金額或日期
  DELETE // 刪了已配對的紀錄
}

enum DebtProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// 兩位使用者各一個對象接在一起（3b-2 決策 56、57）。一對使用者只存一筆，
/// id 較小者放 userLowId，對象也跟著放同一側。
///
/// 資料庫另有 CHECK 約束 `CounterpartyLink_ordered`（userLowId < userHighId），只存在於 migration。
/// 解除連動＝刪掉這一列；雙方的對象與紀錄都保留（決策 71）。
model CounterpartyLink {
  id                 String   @id @default(uuid())
  userLowId          String
  userHighId         String
  counterpartyLowId  String   @unique
  counterpartyHighId String   @unique
  createdAt          DateTime @default(now())

  userLow          User         @relation("CounterpartyLinkLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh         User         @relation("CounterpartyLinkHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  counterpartyLow  Counterparty @relation("CounterpartyLinkLowCounterparty", fields: [counterpartyLowId], references: [id], onDelete: Cascade)
  counterpartyHigh Counterparty @relation("CounterpartyLinkHighCounterparty", fields: [counterpartyHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
}

/// 連動後，一方記、改、刪一筆紀錄時送給對方確認的變更（3b-2 §3.3）。
/// 發起者那筆在送出時就已經生效；提議只決定對方那邊要不要跟著寫。
///
/// 資料庫另有部分唯一索引 `DebtProposal_one_pending_per_source`：同一筆紀錄同時最多一個
/// PENDING 提議（決策 68），只存在於 migration。
model DebtProposal {
  id            String             @id @default(uuid())
  fromUserId    String
  toUserId      String
  type          DebtProposalType
  /// 發起者那筆。DELETE 時是已軟刪除的那筆。
  sourceEntryId String
  /// AMEND、DELETE：送出當下與它配對的、接受者那筆。CREATE 為 null。
  targetEntryId String?
  /// 發起者那筆的種類（發起者的角度）。回應給接受者時才換角度。
  entryKind     DebtEntryKind
  /// 正整數。CREATE、AMEND 是提議的值；DELETE 是刪除當下那筆的值。
  amount        Int
  date          DateTime
  /// 還款帶了以此結清：接受者那邊依自己的餘額補結清差額。
  settle        Boolean            @default(false)
  status        DebtProposalStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  fromUser    User       @relation("DebtProposalFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User       @relation("DebtProposalTo", fields: [toUserId], references: [id], onDelete: Cascade)
  sourceEntry DebtEntry  @relation("DebtProposalSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  targetEntry DebtEntry? @relation("DebtProposalTarget", fields: [targetEntryId], references: [id], onDelete: SetNull)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([sourceEntryId, status])
}
