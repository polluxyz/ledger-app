# ── apps/api ──────────────────────────────────────────────
# PostgreSQL connection string (Prisma CLI and runtime)
# Format: postgresql://USER:PASSWORD@localhost:5432/ledger_dev
DATABASE_URL=

# Secret used to sign JWT tokens (generate a long random string)
JWT_SECRET=

# Lifetime of issued JWT access tokens (e.g. 7d, 24h; default: 7d)
JWT_EXPIRES_IN=7d

# Port the NestJS API listens on (default: 3000)
PORT=3000

# Network address the API listens on (default: localhost, this machine only).
# Keep localhost: the web app calls localhost, and on Windows it resolves to ::1
# first, so 127.0.0.1 would make every browser connection wait for a fallback.
# Use 0.0.0.0 only when a phone, another device or a container must reach it.
HOST=localhost

# AI text parsing (fake needs no external credentials)
LLM_PROVIDER=fake
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Optional thinking level sent as reasoning_effort: low | high | max.
# Blank sends nothing. glm-5.3 needs low to answer within the 25s timeout.
GLM_REASONING_EFFORT=

# Vertex uses a fixed Google endpoint and OAuth; no inference API key.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Example: deepseek-ai/deepseek-v4.1-flash-maas (this model requires global).
VERTEX_MODEL=
# Local ADC: gcloud auth application-default login --impersonate-service-account=...
# VM: attach a service account, or configure ADC with Workload Identity Federation.
# Key file: keep it outside the repo and every worktree; set its path below.
GOOGLE_APPLICATION_CREDENTIALS=

# Daily AI calls (Taiwan calendar day); 0 disables calls. Blank uses defaults.
# Per-user parsing: integer 0..10000; global AI: integer 0..1000000.
AI_PARSE_DAILY_LIMIT_PER_USER=50
AI_DAILY_LIMIT_GLOBAL=500
# Per-request output tokens: integer 256..32768 (blank defaults to 2048).
AI_PARSE_MAX_OUTPUT_TOKENS=2048

# Frontend origin allowed to call this API (CORS). The web app runs on a
# different port, so the browser blocks its requests unless the API allows
# this origin explicitly. Default: http://localhost:5173 (Vite dev server).
# Set this to the deployed web address in production.
#
# Multiple origins go in one comma-separated list, e.g.
# CORS_ORIGIN=https://app.example.com,https://staging.example.com
# Each entry is still matched exactly; the comma only packs the list into one
# variable and does not relax any single match.
CORS_ORIGIN=http://localhost:5173

# ── e2e tests ─────────────────────────────────────────────
# The e2e suite reads apps/api/.env.test (git-ignored) and runs against a
# SEPARATE database (ledger_test) so it never touches dev data. Create it with
# the same keys as above but a ledger_test DATABASE_URL. Example:
#   DATABASE_URL=postgresql://ledger:PASSWORD@localhost:5432/ledger_test
#   JWT_SECRET=any-value-for-tests
